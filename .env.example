# CALL-E API Configuration (Get from https://dashboard.heycall-e.com)
CALLE_API_KEY="iams_live_your_api_key_here"
CALLE_API_URL="https://api.heycall-e.com/v1"

# Telephony Mode: Set to true for offline simulated calls, false for real CALL-E phone calls
FORCE_SIMULATION=false

# Approval Gates (USD)
APPROVAL_HIGH_THRESHOLD=5000.0
APPROVAL_LOW_THRESHOLD=500.0

# Optional LLM API Keys (for live prompt enhancement)
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Server & Database Settings
DATABASE_URL="sqlite+aiosqlite:///./relay.db"
HOST="0.0.0.0"
PORT=8000
FRONTEND_URL="http://localhost:3000"
