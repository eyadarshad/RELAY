# CALL-E API Configuration (Get from https://dashboard.heycall-e.com)
CALLE_API_KEY=""
CALLE_API_URL="https://api.heycall-e.com/v1"

# Telephony Mode: Default is true (Safe Sandbox Mode with zero external side effects).
# Set to false only when you explicitly want to dispatch real phone calls with a valid CALLE_API_KEY.
FORCE_SIMULATION=true

# Approval Gates (USD) - Halts before binding commitment if total price exceeds threshold
APPROVAL_HIGH_THRESHOLD=5000.0
APPROVAL_LOW_THRESHOLD=500.0

# Optional LLM API Keys (for live prompt enhancement)
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Server & Database Settings
DATABASE_URL="sqlite+aiosqlite:///./relay.db"
HOST="0.0.0.0"
PORT=8000
FRONTEND_URL="http://localhost:3000"
